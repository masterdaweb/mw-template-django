# On Master da Web the project gives these: DJANGO_SECRET_KEY (generated),
# DATABASE_URL (the database binding) and AWS_* (the bucket binding).
# Export them to run the app on your machine.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DATABASE_URL=postgresql://app:app@localhost:5432/app
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=
